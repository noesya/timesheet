<% content_for :title, @cycle %>
<% content_for :surtitle do %>
  <%= link_to('Cycles', cycles_path) %> / 
  <%= @cycle.code %>
<% end %>
<div class="d-print-none">
  <%= link_to "Modifier", edit_cycle_path(@cycle), class: 'btn btn-primary' %> 
</div>

<p>
  <% if @cycle.started_at %>
    <%= l @cycle.started_at %>
  <% end %>
  <% if @cycle.ended_at %>
    — <%= l @cycle.ended_at %>
  <% end %>
</div>
<div>
  <%= simple_format @cycle.description %>
</div>
