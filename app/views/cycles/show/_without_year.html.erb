
<% content_for :surtitle, link_to('Cycles', cycles_path) %>

<div class="d-print-none">
  <%= link_to "Modifier", edit_cycle_path(@cycle), class: 'btn btn-primary' %> 
</div>

<p>
  <% if @cycle.started_at %>
    <%= l @cycle.started_at %>
  <% end %>
  <% if @cycle.ended_at %>
    — <%= l @cycle.ended_at %>
  <% end %>
</div>
<div>
  <%= simple_format @cycle.description %>
</div>

<h2 class="h3 mt-5 mb-3">Cycle total</h2>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Personne</th>
      <th width="20%">Jours</th>
      <th width="20%">Coût par jour</th>
      <th width="20%">Coût total</th>
    </tr>
  </thead>
  <tbody>
    <% @cycle.users.each do |user| %>
      <tr>
        <td><%= user %></td>
        <td><%= user.days_logged(cycle: @cycle) %></td>
        <td><%= number_to_currency user.cost_per_day, precision: 0 %></td>
        <td><%= number_to_currency user.cost(cycle: @cycle), precision: 0 %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
      <tr>
        <th>Total</th>
        <th><%= @cycle.days_logged %></th>
        <th></th>
        <th><%= number_to_currency @cycle.cost, precision: 0 %></th>
      </tr>
  </tfoot>
</table>

<% @cycle.years.ordered.each do |year| %>
  <h2 class="h3 mt-5 mb-3"><%= link_to year, [year, @cycle] %></h2>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Personne</th>
        <th width="20%">Jours</th>
        <th width="20%">Coût par jour</th>
        <th width="20%">Coût total</th>
      </tr>
    </thead>
    <tbody>
      <% @cycle.users.each do |user| %>
        <tr>
          <td><%= user %></td>
          <td><%= user.days_logged(cycle: @cycle, year: year) %></td>
          <td><%= number_to_currency user.cost_per_day, precision: 0 %></td>
          <td><%= number_to_currency user.cost(cycle: @cycle, year: year), precision: 0 %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
        <tr>
          <th>Total</th>
          <th><%= @cycle.days_logged(year: year) %></th>
          <th></th>
          <th><%= number_to_currency @cycle.cost(year: year), precision: 0 %></th>
        </tr>
    </tfoot>
  </table>
<% end %>