<% content_for :title, "Cycles" %>

<%= link_to "Créer", new_cycle_path, class: 'btn btn-primary' %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Code</th>
      <th>Nom</th>
      <th>Début</th>
      <th>Fin</th>
    </tr>
  </thead>
  <tbody>
    <% @cycles.each do |cycle| %>
      <tr>
        <td><%= cycle.code %></td>
        <td><%= link_to cycle, cycle %></td>
        <td><%= l cycle.started_at if cycle.started_at %></td>
        <td><%= l cycle.ended_at if cycle.ended_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.umd.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.css" />

<div id="gantt"></div>
<script>
let tasks = [
  <%
  @cycles.each do |cycle|
    next unless cycle.started_at && cycle.ended_at
    %>
    {
      id: '<%= cycle.id %>',
      name: '<%= cycle.code %>',
      start: '<%= cycle.started_at %>',
      end: '<%= cycle.ended_at %>',
      progress: 100,
    },
  <% end %>
]
let options = {
  view_mode: 'Year',
  infinite_padding: false,
  language: 'fr',
  readonly: true,
  today_button: false,
}
let gantt = new Gantt("#gantt", tasks, options);
</script>