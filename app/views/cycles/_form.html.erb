
<%= simple_form_for(@cycle) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="row">
    <div class="col-lg-3">
      <%= f.input :code %>
    </div>
    <div class="col-lg-9">
      <%= f.input :name %>
    </div>
    <div class="col-lg-6">
      <%= f.input :started_at, html5: true %>
    </div>
    <div class="col-lg-6">
      <%= f.input :ended_at, html5: true %>
    </div>
  </div>
  <%= f.input :description %>

  <div class="form-actions">
    <%= f.button :submit, 'Enregistrer' %>
  </div>
<% end %>
