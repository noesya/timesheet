<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= yield :title %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preload" as="font" href="https://assets.noesya.coop/fonts/signifier/signifier-web-regular.woff2" type="font/woff2" crossOrigin="anonymous">
    <link rel="preload" as="font" href="https://assets.noesya.coop/fonts/signifier/signifier-web-regular-italic.woff2" type="font/woff2" crossOrigin="anonymous">
    <link rel="preload" as="font" href="https://assets.noesya.coop/fonts/signifier/signifier-bold.woff2" type="font/woff2" crossOrigin="anonymous">
    <link rel="preload" as="font" href="https://assets.noesya.coop/fonts/soehne/soehne-web-buch.woff2" type="font/woff2" crossOrigin="anonymous">
    <%= javascript_include_tag "application", defer: true %>
    <%= stylesheet_link_tag "application" %>
    <link rel="stylesheet" href="https://assets.noesya.coop/assets/css/theme.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.6.1/chart.umd.min.js" integrity="sha512-vMRyUfXe50uUhhDC+fk6UYBA/1VPj+I7Jn+wK0A3+wSVeUgT9OCz/xoF2M8KFvrmUOlb4Anv0FQUw8NafuzYPw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="icon" type="image/png" href="https://assets.noesya.coop/images/share/favicon.png" />
  </head>
  <body>
    <%= render 'header' %>
    <main aria-label="Content">
      <header>
        <div>
          <% if yield(:surtitle).present? %>
            <p class="h1"><%= yield :surtitle %></p>
          <% end %>
          <h1><%= yield :title %></h1>
        </div>
      </header>
      <section>
        <%= yield %>
      </section>
    </main>
    <%= render 'footer' %>
  </body>
</html>
