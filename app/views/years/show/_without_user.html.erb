
<% content_for :surtitle, link_to('Années', years_path) %>

<h2 class="h3 mt-5 mb-3">Cycles</h2>
<table class="table table-striped">
    <thead>
      <tr>
        <th>Code</th>
        <th>Nom</th>
        <th width="30%">Jours</th>
      </tr>
    </thead>
    <% @year.cycles.each do |cycle| %>
        <% days = @year.days_logged(cycle: cycle) %>
        <% next if days.zero? %>
        <tr>
          <td><%= cycle.code %></td>
          <td><%= link_to cycle, year_cycle_path(year_id: @year, id: cycle) %></td>
          <td><%= days %></td>
        </tr>
    <% end %>
</table>

<h2 class="h3 mt-5 mb-3">Personnes</h2>
<table class="table table-striped">
    <thead>
      <tr>
        <th>Personne</th>
        <th width="15%">Jours travaillés</th>
        <th width="15%">Jours liés à un cycle</th>
      </tr>
    </thead>
    <tbody>
      <% @year.users.each do |user| %>
        <tr>
          <td><%= link_to user, user %></td>
          <td><%= user.days_logged(year: @year) %></td>
          <td><%= user.days_logged(year: @year, cycle: @year.cycles) %></td>
        </tr>
      <% end %>
    </tbody>
</table>

<div class="d-print-none">
  <h2 class="h3 mt-5 mb-3">Thèmes</h2>
  <table class="table table-striped">
      <thead>
        <tr>
          <th>Thème</th>
          <th width="30%">Jours travaillés</th>
        </tr>
      </thead>
      <% @year.themes.each do |theme| %>
        <% days = @year.days_logged(theme: theme) %>
        <% next if days.zero? %>
        <tr>
          <td><%= link_to theme, year_theme_path(year_id: @year, id: theme) %></td>
          <td><%= days %></td>
        </tr>
      <% end %>
  </table>

  <h2 class="h3 mt-5 mb-3">Semaines</h2>
  <table class="table">
      <thead>
        <tr>
          <th>Semaine</th>
          <th width="50%">Jours travaillés</th>
        </tr>
      </thead>
      <tbody>
        <% @year.weeks.each do |week| %>
          <tr>
            <td><%= link_to week, week %></td>
            <td><%= week.days_logged %></td>
          </tr>
        <% end %>
      </tbody>
  </table>
</div>
