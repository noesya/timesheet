<% content_for :surtitle, link_to(@user, @user) %>

<h2 class="h3 mt-5 mb-3">Opérations</h2>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Code</th>
      <th>Nom</th>
      <th width="30%">Jours</th>
    </tr>
  </thead>
  <% @year.operations.each do |operation| %>
    <% days = @year.days_logged(operation: operation, user: @user) %>
    <% next if days.zero? %>
    <tr>
      <td><%= operation.code %></td>
      <td><%= link_to operation, [@year, operation] %></td>
      <td><%= days %></td>
    </tr>
  <% end %>
  <tfoot>
    <tr>
      <th></th>
      <th>Total</th>
      <th><%= @user.days_logged(year: @year, operation: @year.operations) %></th>
    </tr>
  </tfoot>
</table>

<h2 class="h3 mt-5 mb-3">Thèmes</h2>
<table class="table table-striped">
    <thead>
      <tr>
        <th>Thème</th>
        <th width="30%">Jours</th>
      </tr>
    </thead>
    <% @year.themes.each do |theme| %>
        <% days = @year.days_logged(theme: theme, user: @user) %>
        <% next if days.zero? %>
        <tr>
          <td><%= link_to theme, year_theme_path(year_id: @year, id: theme) %></td>
          <td><%= days %></td>
        </tr>
    <% end %>
</table>

<div class="d-print-none">
  <h2 class="h3 mt-5 mb-3">Affectation aux opérations</h2>
  <table class="table">
      <thead>
        <tr>
          <th>Semaine</th>
          <th>Jours</th>
          <th>Thème et opérations</th>
        </tr>
      </thead>
      <tbody>
        <% @year.weeks.each do |week| %>
          <tr>
            <td>
              <%= link_to week, week %>
              (<%= l week.starting_at %>)
            </td>
            <td><%= week.days_logged(user: @user) %></td>
            <td>
              <%
              week.logs_filtered(user: @user).each do |log|
                next unless log.theme.with_research
                %>
                <div class="row mb-4">
                  <div class="col-lg-4">
                    <%= log.theme %>
                  </div>
                  <div class="col-lg-8">
                    <%= form_with model: log, local: false, class: 'd-inline' do |f| %>
                      <div class="form-check">
                        <%= f.radio_button :operation_id, '',
                                          checked: log.operation_id.nil?,
                                          id: "log_#{log.id}_operation_none",
                                          class: 'form-check-input',
                                          onchange: 'this.form.requestSubmit()' %>
                        <%= f.label :operation_id, 'Pas de recherche', for: "log_#{log.id}_operation_none", class: 'form-check-label' %>
                      </div>
                      <% week.operations_available.each do |operation| %>
                        <div class="form-check">
                          <%= f.radio_button :operation_id, operation.id,
                                            id: "log_#{log.id}_operation_#{operation.id}",
                                            class: 'form-check-input',
                                            onchange: 'this.form.requestSubmit()' %>
                          <%= f.label :operation_id, operation.to_full_s, for: "log_#{log.id}_operation_#{operation.id}", class: 'form-check-label' %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
                <hr>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
  </table>
</div>

<h2 class="h3 mt-5 mb-3">Feuilles de temps</h2>
<table class="table">
    <thead>
      <tr>
        <th>Semaine</th>
        <th width="20%">Jours travaillés</th>
        <th width="20%">Jours liés à une opération</th>
        <th width="20%">Jours hors opération</th>
      </tr>
    </thead>
    <tbody>
      <% @year.weeks.each do |week| %>
        <tr>
          <td><%= link_to week, week %></td>
          <td><%= week.days_logged(user: @user) %></td>
          <td><%= week.days_logged(user: @user, operation: @year.operations) %></td>
          <td><%= week.days_logged(user: @user, operation: [nil]) %></td>
        </tr>
      <% end %>
    </tbody>
</table>
