<% content_for :surtitle, link_to(@user, @user) %>

<h2 class="h3 mt-5 mb-3">Cycles</h2>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Code</th>
      <th>Nom</th>
      <th width="30%">Jours</th>
    </tr>
  </thead>
  <% @year.cycles.each do |cycle| %>
    <% days = @year.days_logged(cycle: cycle, user: @user) %>
    <% next if days.zero? %>
    <tr>
      <td><%= cycle.code %></td>
      <td><%= link_to cycle, [@year, cycle] %></td>
      <td><%= days %></td>
    </tr>
  <% end %>
  <tfoot>
    <tr>
      <th></th>
      <th>Total</th>
      <th><%= @user.days_logged(year: @year, cycle: @year.cycles) %></th>
    </tr>
  </tfoot>
</table>

<h2 class="h3 mt-5 mb-3">Thèmes</h2>
<table class="table table-striped">
    <thead>
      <tr>
        <th>Thème</th>
        <th width="30%">Jours</th>
      </tr>
    </thead>
    <% @year.themes.each do |theme| %>
        <% days = @year.days_logged(theme: theme, user: @user) %>
        <% next if days.zero? %>
        <tr>
          <td><%= link_to theme, year_theme_path(year_id: @year, id: theme) %></td>
          <td><%= days %></td>
        </tr>
    <% end %>
</table>

<div class="d-print-none">
  <h2 class="h3 mt-5 mb-3">Affectation aux cycles</h2>
  <table class="table">
      <thead>
        <tr>
          <th>Semaine</th>
          <th>Jours</th>
          <th>Thème et cycles</th>
        </tr>
      </thead>
      <tbody>
        <% @year.weeks.each do |week| %>
          <tr>
            <td>
              <%= link_to week, week %>
              (<%= l week.starting_at %>)
            </td>
            <td><%= week.days_logged(user: @user) %></td>
            <td>
              <% week.logs_filtered(user: @user).each do |log| %>
                <div class="row mb-4">
                  <div class="col-lg-4">
                    <%= log.theme %>
                  </div>
                  <div class="col-lg-8">
                    <%= form_with model: log, local: false, class: 'd-inline' do |f| %>
                      <div class="form-check">
                        <%= f.radio_button :cycle_id, '',
                                          checked: log.cycle_id.nil?,
                                          id: "log_#{log.id}_cycle_none",
                                          class: 'form-check-input',
                                          onchange: 'this.form.requestSubmit()' %>
                        <%= f.label :cycle_id, 'Pas de recherche', for: "log_#{log.id}_cycle_none", class: 'form-check-label' %>
                      </div>
                      <% week.cycles_available.each do |cycle| %>
                        <div class="form-check">
                          <%= f.radio_button :cycle_id, cycle.id,
                                            id: "log_#{log.id}_cycle_#{cycle.id}",
                                            class: 'form-check-input',
                                            onchange: 'this.form.requestSubmit()' %>
                          <%= f.label :cycle_id, cycle.to_full_s, for: "log_#{log.id}_cycle_#{cycle.id}", class: 'form-check-label' %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
                <hr>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
  </table>
</div>

<h2 class="h3 mt-5 mb-3">Feuilles de temps</h2>
<table class="table">
    <thead>
      <tr>
        <th>Semaine</th>
        <th width="20%">Jours travaillés</th>
        <th width="20%">Jours liés à un cycle</th>
        <th width="20%">Jours hors cycle</th>
      </tr>
    </thead>
    <tbody>
      <% @year.weeks.each do |week| %>
        <tr>
          <td><%= link_to week, week %></td>
          <td><%= week.days_logged(user: @user) %></td>
          <td><%= week.days_logged(user: @user, cycle: @year.cycles) %></td>
          <td><%= week.days_logged(user: @user, cycle: [nil]) %></td>
        </tr>
      <% end %>
    </tbody>
</table>
